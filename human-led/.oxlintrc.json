{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/logic/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../ui", "../ui/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../render", "../render/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../audio", "../audio/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../loop", "../loop/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../tuning", "../tuning/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../preferences", "../preferences/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../i18n", "../i18n/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              },
              {
                "group": ["../assets", "../assets/*"],
                "message": "ルール（logic）は、ほかの層に依存しない純関数に保つ"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/loop/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../ui", "../ui/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              },
              {
                "group": ["../render", "../render/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              },
              {
                "group": ["../audio", "../audio/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              },
              {
                "group": ["../tuning", "../tuning/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              },
              {
                "group": ["../preferences", "../preferences/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              },
              {
                "group": ["../i18n", "../i18n/*"],
                "message": "セッション（loop）は、画面や音や保存を知らない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/render/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../ui", "../ui/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              },
              {
                "group": ["../audio", "../audio/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              },
              {
                "group": ["../loop", "../loop/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              },
              {
                "group": ["../tuning", "../tuning/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              },
              {
                "group": ["../preferences", "../preferences/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              },
              {
                "group": ["../i18n", "../i18n/*"],
                "message": "盤面の描画（render）は、ゲームの状態だけを読む"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/audio/**", "src/tuning/**", "src/preferences/**", "src/i18n/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../ui", "../ui/*"],
                "message": "画面の部品と描画には依存しない"
              },
              {
                "group": ["../render", "../render/*"],
                "message": "画面の部品と描画には依存しない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/logic/testing.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
